  "alignment_metrics": {
    "cross_ntk": {
      "description": "Cross-modal Neural Tangent Kernel stability measure",
      "range": [0.0, 1.0],
      "interpretation": {
        "0.0-0.25": "Phase incompatible - poor alignment expected",
        "0.25-0.5": "Partially compatible - moderate alignment possible",
        "0.5-1.0": "Phase compatible - good alignment expected"
      }
    },
    "cosine_similarity": {
      "description": "Average cosine similarity between paired features",
      "range": [-1.0, 1.0],
      "interpretation": {
        "-1.0-0.0": "Anti-aligned features",
        "0.0-0.3": "Poorly aligned features",
        "0.3-0.7": "Moderately aligned features",
        "0.7-1.0": "Well-aligned features"
      }
    },
    "compression_ratio": {
      "description": "Effective dimensionality ratio from SVD analysis",
      "range": [0.0, 1.0],
      "interpretation": {
        "0.0-0.3": "Highly compressed representation",
        "0.3-0.7": "Moderately compressed representation",
        "0.7-1.0": "Low compression, high dimensionality"
      }
    }
  }
}